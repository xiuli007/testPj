<Window x:Class="JapaneseTranscriptionPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日语会议 · 本地双语字幕台"
        Width="1120" Height="960" MinWidth="820" MinHeight="720"
        Background="#172338" Foreground="#F0F4FA" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#202F44"/>
    <SolidColorBrush x:Key="CardRaisedBrush" Color="#293A52"/>
    <SolidColorBrush x:Key="LineBrush" Color="#465C77"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#B9C8DC"/>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#293B53"/>
      <Setter Property="Foreground" Value="#F0F4FA"/>
      <Setter Property="BorderBrush" Value="#526985"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#83A9D8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#60A5FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#377DC9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#70A9E8"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="#DCE6F2"/>
      <Setter Property="Foreground" Value="#1B2A3D"/>
      <Setter Property="BorderBrush" Value="#8297B2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="#1B2A3D"/>
      <Setter Property="Background" Value="#DCE6F2"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#377DC9"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Foreground" Value="#F0F4FA"/>
      <Setter Property="BorderBrush" Value="#526985"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#1B2A3D"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="#93C5FD"/>
      <Setter Property="SelectionBrush" Value="#365E96"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="#E0E8F3"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type Expander}">
      <Setter Property="Foreground" Value="#E0E8F3"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22" MaxWidth="1000" HorizontalAlignment="Center">
      <Grid Margin="2,0,2,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="26" FontWeight="Bold" Foreground="#F7FAFF"
                     Text="日语会议 · 本地双语字幕台"/>
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13"
                     TextWrapping="Wrap">
            选择会议扬声器，在本机识别日语并翻译成简体中文。
          </TextBlock>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Top" Padding="12,7" CornerRadius="14"
                Background="#233C5E" BorderBrush="#42658E" BorderThickness="1">
          <TextBlock Text="本地处理 · 不上传" Foreground="#C3DDFF" FontSize="12" FontWeight="SemiBold"/>
        </Border>
      </Grid>

      <Border Padding="20" Margin="0,0,0,14" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="15">
        <StackPanel>
          <Grid Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="实时字幕控制" FontSize="18" FontWeight="Bold" Foreground="#F7FAFF"/>
              <TextBlock Text="手动选择播放设备；开始后才会采集。" Margin="0,4,0,0"
                         Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="12"
                    Padding="9,5" Background="#2D4058">
              <TextBlock Text="WASAPI Loopback" Foreground="#D0DCF0" FontSize="11" FontWeight="SemiBold"/>
            </Border>
          </Grid>

          <Border Background="#4B3D25" BorderBrush="#A78443" BorderThickness="1"
                  CornerRadius="9" Padding="12,9" Margin="0,0,0,13">
            <TextBlock Text="设备级采集也会包含同一输出设备上其他程序的声音，并非只采集 Teams。不会自动开始录音。"
                       TextWrapping="Wrap" Foreground="#FFE7B2" FontSize="12"/>
          </Border>

          <TextBlock Text="播放设备" Foreground="#D0DBEA" FontWeight="SemiBold"
                     FontSize="12" Margin="1,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding AudioInputs}" SelectedItem="{Binding SelectedAudioInput}"
                      IsEnabled="{Binding CanEditDevices}" DisplayMemberPath="DisplayName"/>
            <Button Grid.Column="1" Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                    Padding="13,8" Margin="9,0,0,0"/>
          </Grid>

          <WrapPanel Margin="0,13,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="开始双语字幕"
                    Command="{Binding StartLiveCommand}" Margin="0,0,8,8"/>
            <Button Content="停止字幕" Command="{Binding StopLiveCommand}" Margin="0,0,8,8"/>
            <Button Content="测试自制 WAV…" Command="{Binding TestFileCommand}" Margin="0,0,16,8"/>
            <CheckBox Content="显示置顶字幕台" IsChecked="{Binding ShowOverlay}" Margin="0,0,0,8"/>
          </WrapPanel>

          <Border Background="#1B2A3D" BorderBrush="#465C77" BorderThickness="1"
                  CornerRadius="9" Padding="12,9" Margin="0,2,0,0">
            <TextBlock Text="{Binding CaptionStatus}" TextWrapping="Wrap"
                       Foreground="#E0E8F3" FontSize="12"/>
          </Border>
        </StackPanel>
      </Border>

      <Border Padding="20" Margin="0,0,0,14" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="15">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="双语字幕时间线" FontSize="17" FontWeight="Bold" Foreground="#F7FAFF"/>
              <TextBlock Text="新字幕追加在末尾；可以向上滚动回看本次会话。"
                         Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Captions.Count, StringFormat=本次 {0} 条}"
                       Foreground="#B9C8DC" FontSize="12" VerticalAlignment="Center"/>
          </Grid>
          <ListBox x:Name="CaptionTimeline" ItemsSource="{Binding Captions}" Height="260"
                   Background="#19283D" Foreground="#F0F4FA" BorderBrush="#465C77"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#344A65"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel Margin="0,0,0,5">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                               Foreground="#B0C1D7" FontSize="11" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Japanese}" TextWrapping="Wrap"
                               Foreground="#D4DFEE" FontSize="13"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Chinese}" TextWrapping="Wrap"
                             Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="历史保存默认关闭。未开启时，本次记录只在当前窗口内；关闭程序后不会保留。"
                     Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                     Margin="2,9,2,0"/>
        </StackPanel>
      </Border>

      <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="15">
        <StackPanel>
          <TextBlock Text="跨会话历史" FontSize="16" FontWeight="Bold" Foreground="#F7FAFF"/>
          <TextBlock Text="所有启用期间的字幕追加到同一个 UTF-8 CSV；已有文件只追加，不覆盖。"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"
                     TextWrapping="Wrap" Margin="0,4,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding HistoryFilePath, Mode=OneWay}" IsReadOnly="True"
                     ToolTip="{Binding HistoryFilePath}" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="选择文件…" Command="{Binding ChooseHistoryFileCommand}"
                    Margin="8,0,0,0" Padding="13,8"/>
          </Grid>
          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding HistoryActionText}"
                    Command="{Binding ToggleHistorySavingCommand}" Margin="0,0,10,8"/>
            <TextBlock Text="{Binding HistoryStatus}" Foreground="#D0DCEC"
                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                       MaxWidth="760" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock Text="设置保存在当前 Windows 用户的 LocalAppData；文件路径由你选择。若写入失败，状态会明确提示，未写入字幕会留在本次窗口并可重试。"
                     Foreground="#B0C0D4" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="15">
        <Expander Header="本地模型配置 · Qwen3-ASR + LMT 日→中（CPU int8）"
                  Padding="0,2,0,0">
          <StackPanel IsEnabled="{Binding CanUseManualTools}" Margin="0,14,0,0">
            <TextBlock Text="Python（隔离环境）" Foreground="#D0DBEA" FontSize="12"/>
            <TextBox Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
            <TextBlock Text="Qwen3-ASR sherpa-onnx 模型目录" Foreground="#D0DBEA" FontSize="12"/>
            <TextBox Text="{Binding AsrModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
            <TextBlock Text="LMT-60-1.7B CTranslate2 模型目录" Foreground="#D0DBEA" FontSize="12"/>
            <TextBox Text="{Binding TranslationModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,2"/>
          </StackPanel>
        </Expander>
      </Border>

      <Border Padding="18" Margin="0,0,0,14" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="15">
        <Expander Header="手动录音 / 本地模型验证" IsExpanded="False" Padding="0,2,0,0">
          <StackPanel IsEnabled="{Binding CanEditDevices}" Margin="0,14,0,0">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F0F4FA"
                       Text="录音来源与录制"/>
            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap">
              Loopback 捕获所选播放设备实际输出的声音。独占模式、静音或路由到其他输出的音频可能无法捕获；请选择 Teams 当前使用的播放设备进行验证。
            </TextBlock>
            <ComboBox ItemsSource="{Binding AudioInputs}" SelectedItem="{Binding SelectedAudioInput}"
                      IsEnabled="{Binding CanEditDevices}" DisplayMemberPath="DisplayName"/>
            <WrapPanel Margin="0,11,0,0">
              <Button MinWidth="120" Content="开始录音" Command="{Binding RecordCommand}" Margin="0,0,8,8"/>
              <Button MinWidth="100" Content="停止" Command="{Binding StopCommand}" Margin="0,0,8,8"/>
              <Button MinWidth="130" Content="手动保存 WAV" Command="{Binding SaveRecordingCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Margin="1,2,0,0" Foreground="{StaticResource MutedBrush}"
                       Text="{Binding AudioDuration, StringFormat=音频时长：{0}}"/>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14"/>
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F0F4FA"
                       Text="本地识别与翻译"/>
            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap">
              使用上方配置的本地模型。模型只在开始识别/字幕时加载；音频与文字不上传。
            </TextBlock>
            <Button MinWidth="140" HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButton}" Content="识别并翻译录音"
                    Command="{Binding TranscribeCommand}"/>

            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14"/>
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F0F4FA"
                       Text="转写结果与评估"/>
            <TextBlock Margin="0,10,0,5" Text="转写文本" Foreground="#D0DBEA" FontSize="12"/>
            <TextBox MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                     Text="{Binding TranscriptionText, Mode=OneWay}"/>
            <TextBlock Margin="0,12,0,5" Text="可选参考文本（日语）" Foreground="#D0DBEA" FontSize="12"/>
            <TextBox MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="1,8,1,0" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap">
              CER 按 Unicode 文本元素计算编辑距离 ÷ 参考文本元素数；忽略空白，不忽略标点。请仅使用获准公开或自制的非敏感素材。
            </TextBlock>
            <WrapPanel Margin="1,12,0,0">
              <TextBlock Margin="0,0,20,6" Foreground="#E0E8F3"
                         Text="{Binding ProcessingTime, StringFormat=转写耗时：{0}}"/>
              <TextBlock Margin="0,0,20,6" Foreground="#E0E8F3"
                         Text="{Binding RealTimeCoefficient, StringFormat=实时速度：{0}}"/>
              <TextBlock Margin="0,0,0,6" Foreground="#E0E8F3"
                         Text="{Binding CharacterErrorRateText, StringFormat=CER：{0}}"/>
            </WrapPanel>
          </StackPanel>
        </Expander>
      </Border>

      <Border Padding="13" Background="#223148" BorderBrush="#465C77"
              BorderThickness="1" CornerRadius="10">
        <TextBlock Foreground="#D0DCEC" TextWrapping="Wrap" FontSize="12"
                   Text="{Binding Status}"/>
      </Border>
      <TextBlock Margin="2,10,2,4" Foreground="#B0C0D4" FontSize="11" TextWrapping="Wrap">
        录音默认只存放在本机临时目录：转写成功后或应用关闭时自动清理。只有点击“手动保存 WAV”才会复制到你指定的位置；转写文本不会自动保存。
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</Window>
