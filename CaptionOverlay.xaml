<Window x:Class="JapaneseTranscriptionPrototype.CaptionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双语字幕台" Width="900" Height="430" MinWidth="460" MinHeight="220"
        Topmost="True" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="White" ResizeMode="CanResizeWithGrip"
        Loaded="Overlay_Loaded" Closed="Overlay_Closed" Closing="HideCaption">
  <Border Margin="8" Padding="18,15" CornerRadius="16"
          Background="#E63A4A63" BorderBrush="#C07D95B2" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="2,0,0,12" MouseLeftButtonDown="DragCaption">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="DragCaption">
          <Border Width="4" Height="19" CornerRadius="2" Background="#77B7FF"
                  VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="会议字幕台" Foreground="#F8FAFF" FontSize="14"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="  日语原文 · 简体中文译文" Foreground="#CDD9E8"
                     FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="置顶" Foreground="#C3DBF8" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Grid.Column="2" Content="×" Width="30" Height="28" MinHeight="28"
                Padding="0" FontSize="17" Foreground="#E0E9F5"
                Background="#40536D" BorderBrush="#7188A7" Click="CloseCaption"
                ToolTip="隐藏字幕台"/>
      </Grid>

      <ListBox x:Name="CaptionTimeline" Grid.Row="1" ItemsSource="{Binding Captions}"
               Background="#B52B3B50" Foreground="#FFFFFF" BorderBrush="#687E9C"
               BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="True"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#576C88"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                         Foreground="#B7C9E0" FontSize="11" Margin="0,2,12,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Japanese}" FontSize="14" TextWrapping="Wrap"
                           Foreground="#DDE6F2" Margin="0,0,0,7"/>
                <TextBlock Text="{Binding Chinese}" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="#FFFFFF"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="2" Margin="3,10,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CaptionStatus}" FontSize="11"
                   Foreground="#D4DFEE" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="清除字幕" Command="{Binding ClearCaptionsCommand}"
                Background="#40536D" Foreground="#E0E9F5" BorderBrush="#7188A7"
                Padding="8,4" Margin="10,0,0,0"
                ToolTip="仅清空两窗显示；保留 CSV 和待写记录，不停止识别。"/>
        <TextBlock Grid.Column="2" Text="{Binding Captions.Count, StringFormat={}{0} 条}"
                   FontSize="11" Foreground="#BCCBDF" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </Grid>
    </Grid>
  </Border>
</Window>
